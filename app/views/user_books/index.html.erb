<% content_for :title, "User Books" %>

<h1>User Books</h1>

<p><strong>Successfully authenticated with Google.</strong></p>

<%= link_to "Sign Out", destroy_admin_session_path %>

<div id="user_books">
  <% @user_books.each do |user_book| %>
    <%= render user_book %>

    <p>
      <%= link_to "Show this user book", user_book %>
    </p>
  <% end %>
</div>

<p><%= link_to "Books", books_path %></p>

<p><%= link_to "Users", users_path %></p>

<p><%= link_to "New User Book", new_user_book_path %></p>