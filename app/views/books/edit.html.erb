<h1>Update Book</h1>

<%= form_with model: @book do |form| %>
    <p>
        <%= form.label :title %>
        <%= form.text_field :title %>
    </p>

    <p>
        <%= form.label :author %><br>
        <%= form.text_field  :author %>
    </p>

    <p>
        <%= form.label :price %><br>
        <%= form.number_field :price, step: 0.01 %>
    </p>

    <p>
        <%= form.label :published_date %><br>
        <%= form.date_select :published_date %>
    </p>

    <%= form.submit "Update Book" %>
<% end %>

<p>
    <%= link_to "Back to Home", books_path %>
</p